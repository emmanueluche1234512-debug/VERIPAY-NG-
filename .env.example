# ==============================================================================
# VERIPAY NG — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice: This file lists variable names and documentation only.
# NEVER commit real credentials, service keys, or tokens to version control.
# ==============================================================================

# Application URL (AI Studio automatically injects this at runtime with Cloud Run URL)
APP_URL="https://example.com"

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Phase 2: Authentication & Core Database)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: The Supabase project API URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Safe for browser use with Row Level Security (RLS) enabled
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Privileged backend access only. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH & GMAIL API (Phase 4 & 5: Bank Alert Email Ingestion)
# ------------------------------------------------------------------------------
# Per-developer multi-tenant OAuth client credentials for least-privilege Gmail access
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://example.com/api/auth/google/callback"

# ------------------------------------------------------------------------------
# GEMINI AI API (Phase 6: Structured Bank Alert Extraction)
# ------------------------------------------------------------------------------
# Used server-side strictly for structured entity extraction (amount, sender, type).
# AI does not authorize payments; a deterministic engine handles verification.
GEMINI_API_KEY="your-gemini-api-key"

# ------------------------------------------------------------------------------
# TELEGRAM BOT API (Phase 11: Optional Merchant Notifications)
# ------------------------------------------------------------------------------
# Server-side token for the pre-existing Veripay Telegram notification bot.
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# ------------------------------------------------------------------------------
# SECURITY & WEBHOOK CRYPTOGRAPHY (Phase 3A, 9 & 10: API Keys & Webhooks)
# ------------------------------------------------------------------------------
# Project-scoped secret key used by external Merchant Backends connecting via VeripayClient.
# NEVER expose private credentials in VITE_VERIPAY_SECRET_KEY or browser JavaScript.
VERIPAY_API_KEY="vpay_live_your_project_scoped_secret_key"

# Master secret used for generating HMAC SHA-256 signatures on outgoing merchant webhooks
WEBHOOK_SIGNING_SECRET="your-webhook-signing-secret"
